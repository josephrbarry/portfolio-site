---
import Base from '../../layouts/Base.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Project };
const i = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(i + 1) % projects.length];
---

<Base title={p.title} description={p.card}>
  <section class="bg-navy-deep text-white">
    <div class="mx-auto max-w-6xl px-5 pb-16 pt-14 sm:px-8">
      <a href="/#work" class="font-mono text-sm text-tint/70 hover:text-white">← All work</a>
      <p class="mt-8 font-mono text-sm text-gold">{p.kicker}</p>
      <h1 class="mt-3 max-w-4xl font-display text-4xl font-semibold leading-tight sm:text-6xl">{p.title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-tint/90">{p.question}</p>
      <p class="mt-8 max-w-3xl border-l-4 border-gold pl-4 font-display text-xl font-medium sm:text-2xl">{p.verdict}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        {p.download && (
          <a
            href={p.download.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-gold px-5 py-3 font-mono text-sm font-medium text-navy-deep hover:bg-white"
          >
            {p.download.label} <span aria-hidden="true">→</span>
          </a>
        )}
        {p.github && (
          <a
            href={p.github}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 border border-tint/40 px-5 py-3 font-mono text-sm text-tint hover:border-white hover:text-white"
          >
            View on GitHub <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {p.stats.map((s) => (
        <div class="rounded-lg border border-navy/10 bg-white p-5">
          <p class="font-display text-3xl font-semibold text-navy">{s.value}</p>
          <p class="mt-2 text-sm leading-snug text-mute">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-5 pb-16 sm:px-8 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <p class="font-mono text-sm text-accent">Findings</p>
      <ol class="mt-5 flex flex-col gap-6">
        {p.findings.map((f, n) => (
          <li class="flex gap-4">
            <span class="font-mono text-sm text-gold">0{n + 1}</span>
            <p class="leading-relaxed">
              <strong class="font-semibold text-navy">{f.head}</strong> {f.body}
            </p>
          </li>
        ))}
      </ol>
    </div>
    <div class="lg:col-span-2">
      <p class="font-mono text-sm text-accent">How it was built</p>
      <ul class="mt-5 flex flex-col gap-4">
        {p.built.map((b) => (
          <li class="border-l-2 border-tint pl-4 text-sm leading-relaxed text-ink/85">{b}</li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-2">
        {p.tools.map((t) => (
          <span class="rounded bg-tint px-2 py-1 font-mono text-xs text-navy">{t}</span>
        ))}
      </div>
    </div>
  </section>

  {p.discrepancies && (
    <section class="border-t border-navy/10 bg-white">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
        <p class="font-mono text-sm text-accent">Discrepancies</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-navy sm:text-4xl">{p.discrepancies.title}</h2>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink/85">{p.discrepancies.intro}</p>

        <figure class="mt-10">
          <div class="overflow-x-auto rounded-lg border border-navy/10">
            <table class="w-full min-w-[34rem] text-left text-sm">
              <thead class="bg-navy-deep text-tint">
                <tr>
                  {p.discrepancies.table.head.map((h, n) => (
                    <th class={`px-3 py-3 font-mono text-xs font-medium ${n >= 2 ? 'text-right' : ''}`}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {p.discrepancies.table.rows.map((r) => (
                  <tr class="border-t border-navy/10">
                    {r.map((c, n) => (
                      <td class={`px-3 py-3 ${n >= 2 ? 'text-right font-mono tabular-nums' : ''} ${n === 2 ? 'text-red-700 line-through decoration-red-700/40' : ''} ${n === 4 ? 'font-semibold text-navy' : ''}`}>{c}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="border-t-2 border-navy bg-tint/40">
                  {p.discrepancies.table.foot.map((c, n) => (
                    <td class={`px-3 py-3 font-semibold text-navy ${n >= 2 ? 'text-right font-mono tabular-nums' : ''}`}>{c}</td>
                  ))}
                </tr>
              </tfoot>
            </table>
          </div>
          <figcaption class="mt-3 text-sm text-mute">{p.discrepancies.table.caption}</figcaption>
        </figure>

        <figure class="mt-12">
          <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {p.discrepancies.witnesses.items.map((w, n) => (
              <li class="rounded-lg border border-navy/10 p-5">
                <p class="font-mono text-xs text-gold">Witness {n + 1}</p>
                <p class="mt-2 font-semibold leading-snug text-navy">{w.source}</p>
                <p class="mt-2 text-sm leading-relaxed text-ink/85">{w.finding}</p>
              </li>
            ))}
          </ol>
          <figcaption class="mt-3 text-sm text-mute">{p.discrepancies.witnesses.caption}</figcaption>
        </figure>

        <div class="mt-12 grid gap-8 sm:grid-cols-2">
          {p.discrepancies.items.map((d) => (
            <div class="border-l-4 border-gold pl-4">
              <p class="font-semibold text-navy">{d.head}</p>
              <p class="mt-2 leading-relaxed text-ink/85">{d.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="font-mono text-sm text-accent">The work</p>
        {p.databook && (
          <div class="inline-flex rounded-full border border-navy/20 p-1" role="tablist" aria-label="The work">
            <button type="button" role="tab" aria-selected="true" data-work-tab="dashboard"
              class="work-tab whitespace-nowrap rounded-full px-3 py-1.5 font-mono text-xs sm:px-4 sm:text-sm">Dashboard · {p.shots.length} pages</button>
            <button type="button" role="tab" aria-selected="false" data-work-tab="databook"
              class="work-tab whitespace-nowrap rounded-full px-3 py-1.5 font-mono text-xs sm:px-4 sm:text-sm">Databook · 23 tabs</button>
          </div>
        )}
      </div>
      <div class="mt-8 flex flex-col gap-12" data-work-panel="dashboard">
        {p.shots.map((s) => (
          <figure>
            <a href={s.src} target="_blank" rel="noopener">
              <img src={s.src} alt={s.caption} loading="lazy" class="w-full rounded border border-navy/10 shadow-sm" />
            </a>
            <figcaption class="mt-3 text-sm text-mute">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
      {p.databook && (
        <div class="mt-8 flex flex-col gap-12" data-work-panel="databook" hidden>
          {p.databook.map((s) => (
            <figure>
              <a href={s.src} target="_blank" rel="noopener">
                <img src={s.src} alt={s.caption} loading="lazy" class="mx-auto w-full max-w-4xl rounded border border-navy/10 shadow-sm" />
              </a>
              <figcaption class="mx-auto mt-3 max-w-4xl text-sm text-mute">{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
      {p.note && <p class="mt-12 text-sm italic text-mute">{p.note}</p>}
    </div>
  </section>

  {p.sources && (
    <section class="border-t border-navy/10">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
        <p class="font-mono text-sm text-accent">Sources</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-navy">Every document I checked against</h2>
        <div class="mt-10 flex flex-col gap-12">
          {p.sources.map((g) => (
            <div>
              <h3 class="font-mono text-xs uppercase tracking-wider text-mute">{g.group}</h3>
              <ol class="mt-4 flex flex-col gap-5">
                {g.items.map((s) => (
                  <li class="border-l-2 border-tint pl-4">
                    <p class="leading-relaxed text-ink">{s.cite}</p>
                    <p class="mt-1 text-sm leading-relaxed text-mute">{s.use}</p>
                    {s.links && (
                      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                        {s.links.map((l) => (
                          <a href={l.href} target="_blank" rel="noopener" class="font-mono text-xs text-accent underline-offset-4 hover:underline">{l.label} ↗</a>
                        ))}
                      </p>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <a href={`/projects/${next.slug}/`} class="group block">
      <p class="font-mono text-sm text-mute">Next</p>
      <p class="mt-2 font-display text-2xl font-semibold text-navy group-hover:text-accent">{next.title} →</p>
    </a>
  </section>
</Base>

<style>
  .work-tab { color: var(--color-navy); }
  .work-tab[aria-selected='true'] { background: var(--color-navy); color: #fff; }
  .work-tab:not([aria-selected='true']):hover { background: var(--color-tint); }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-work-tab]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('[data-work-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.workPanel !== tab.dataset.workTab;
      });
    }),
  );
</script>
