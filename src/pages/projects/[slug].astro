---
import Base from '../../layouts/Base.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Project };
const i = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(i + 1) % projects.length];
---

<Base title={p.title} description={p.card}>
  <section class="bg-navy-deep text-white">
    <div class="mx-auto max-w-6xl px-5 pb-16 pt-14 sm:px-8">
      <a href="/#work" class="font-mono text-sm text-tint/70 hover:text-white">← All work</a>
      <p class="mt-8 font-mono text-sm text-gold">{p.kicker}</p>
      <h1 class="mt-3 max-w-4xl font-display text-4xl font-semibold leading-tight sm:text-6xl">{p.title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-tint/90">{p.question}</p>
      <p class="mt-8 max-w-3xl border-l-4 border-gold pl-4 font-display text-xl font-medium sm:text-2xl">{p.verdict}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        {p.download && (
          <a
            href={p.download.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-gold px-5 py-3 font-mono text-sm font-medium text-navy-deep hover:bg-white"
          >
            {p.download.label} <span aria-hidden="true">→</span>
          </a>
        )}
        {p.github && (
          <a
            href={p.github}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 border border-tint/40 px-5 py-3 font-mono text-sm text-tint hover:border-white hover:text-white"
          >
            View on GitHub <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {p.stats.map((s) => (
        <div class="rounded-lg border border-navy/10 bg-white p-5">
          <p class="font-display text-3xl font-semibold text-navy">{s.value}</p>
          <p class="mt-2 text-sm leading-snug text-mute">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-5 pb-16 sm:px-8 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <p class="font-mono text-sm text-accent">Findings</p>
      <ol class="mt-5 flex flex-col gap-6">
        {p.findings.map((f, n) => (
          <li class="flex gap-4">
            <span class="font-mono text-sm text-gold">0{n + 1}</span>
            <p class="leading-relaxed">
              <strong class="font-semibold text-navy">{f.head}</strong> {f.body}
            </p>
          </li>
        ))}
      </ol>
    </div>
    <div class="lg:col-span-2">
      <p class="font-mono text-sm text-accent">How it was built</p>
      <ul class="mt-5 flex flex-col gap-4">
        {p.built.map((b) => (
          <li class="border-l-2 border-tint pl-4 text-sm leading-relaxed text-ink/85">{b}</li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-2">
        {p.tools.map((t) => (
          <span class="rounded bg-tint px-2 py-1 font-mono text-xs text-navy">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-navy/10 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <p class="font-mono text-sm text-accent">The work</p>
      <div class="mt-8 flex flex-col gap-12">
        {p.shots.map((s) => (
          <figure>
            <a href={s.src} target="_blank" rel="noopener">
              <img src={s.src} alt={s.caption} loading="lazy" class="w-full rounded border border-navy/10 shadow-sm" />
            </a>
            <figcaption class="mt-3 text-sm text-mute">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
      {p.note && <p class="mt-12 text-sm italic text-mute">{p.note}</p>}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <a href={`/projects/${next.slug}/`} class="group block">
      <p class="font-mono text-sm text-mute">Next</p>
      <p class="mt-2 font-display text-2xl font-semibold text-navy group-hover:text-accent">{next.title} →</p>
    </a>
  </section>
</Base>
